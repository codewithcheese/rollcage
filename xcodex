#!/bin/zsh
# xcodex — sandboxed Codex CLI launcher
# Usage: xcodex [codex args...]

__xcodex_dir="${0:A:h}"
source "${__xcodex_dir}/xcodex.lib.zsh"

main() {
  local tmpdir="${TMPDIR:-/private/tmp}"
  local home_dir="$(readlink -f "${HOME}")"
  local project_dir="$(readlink -f "${PWD}")"
  tmpdir="$(readlink -f "$tmpdir")"

  local cache_dir="${tmpdir%/T*}/C"
  local volatile_dir="${tmpdir%/T*}/X"

  if [[ ! -f "${__xcodex_dir}/base-common.sb" || ! -f "${__xcodex_dir}/base-codex.sb" ]]; then
    echo "xcodex: base profile fragments not found at ${__xcodex_dir}/base-common.sb and ${__xcodex_dir}/base-codex.sb" >&2
    return 1
  fi

  local codex_bin
  if ! codex_bin="$(command -v codex 2>/dev/null)"; then
    echo "xcodex: codex not found in PATH" >&2
    return 127
  fi

  if ! command -v sandbox-exec &>/dev/null; then
    echo "xcodex: sandbox-exec not found, running without sandbox" >&2
    "$codex_bin" "$@"
    return
  fi

  local xcodex_dir_resolved="$(readlink -f "${__xcodex_dir}")"
  local profile profile_path rc=0

  profile="$(__xcodex_assemble "$project_dir")" || return 1
  profile_path="${tmpdir}/xcodex-$$.sb"
  echo "$profile" > "$profile_path"

  local -a sandbox_args codex_args
  sandbox_args=(
    -D "PROJECT_DIR=${project_dir}"
    -D "TMPDIR=${tmpdir}"
    -D "CACHE_DIR=${cache_dir}"
    -D "VOLATILE_DIR=${volatile_dir}"
    -D "HOME=${home_dir}"
    -D "XCODEX_DIR=${xcodex_dir_resolved}"
    -f "$profile_path"
  )
  codex_args=(--dangerously-bypass-approvals-and-sandbox)

  # Codex's installation is read-only inside Seatbelt; upgrades must run outside.
  codex_args+=(--config check_for_update_on_startup=false)

  # ChatGPT.app's Node REPL normally asks Codex to create a child Seatbelt
  # sandbox. macOS rejects nested sandbox-exec calls, so run that child
  # directly; it still inherits xcodex's outer Seatbelt profile.
  if __xcodex_uses_chatgpt_node_repl; then
    codex_args+=(--config 'mcp_servers.node_repl.args=["--disable-sandbox"]')
  fi

  codex_args+=("$@")

  # XCLAUDE_ACTIVE is the shared public marker for tools that only need to
  # know they are inside this project's Seatbelt sandbox. XCODEX_ACTIVE is
  # retained as a Codex-specific marker. Codex's own sandbox/approval layer
  # is disabled because sandbox-exec is the actual boundary here.
  env XCLAUDE_ACTIVE=1 XCODEX_ACTIVE=1 \
    sandbox-exec "${sandbox_args[@]}" -- "$codex_bin" "${codex_args[@]}"
  rc=$?

  rm -f "$profile_path"
  return $rc
}

main "$@"
