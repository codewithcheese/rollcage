;; Swift toolchain (SwiftPM + lldb)
;;
;; /usr/bin/swift dispatches to either Xcode or Command Line Tools.
;; SwiftPM state lives under ~/Library/{Caches/,}org.swift.swiftpm, with
;; ~/.swiftpm holding symlinks into them. Build artifacts go under
;; <project>/.build (already writable via PROJECT_DIR).
;;
;; CAVEAT: macOS forbids nested sandbox-exec, so SwiftPM's inner
;; manifest sandbox can't initialize. Pass --disable-sandbox to swift
;; build/run/test/package. The outer rollcage sandbox still applies.

;; Exec — Xcode and CLT. Whole Xcode.app because lldb's debugserver
;; lives in Contents/SharedFrameworks, not Contents/Developer.
;; process-exec* (vs plain process-exec) covers debugger-launched spawn.
(allow process-exec*
  (subpath "/Applications/Xcode.app")
  (subpath "/Library/Developer/CommandLineTools")
  ;; Inferior binaries that lldb launches from the project's build dir.
  (subpath (param "PROJECT_DIR")))

;; Exec — SwiftPM compiles Package.swift to $TMPDIR/TemporaryDirectory.*/<pkg>-manifest
;; and execs it. Base profile blocks TMPDIR exec; this re-allows only
;; the manifest naming pattern, not arbitrary TMPDIR binaries.
(allow process-exec*
  (regex (string-append
    "^" (param "TMPDIR") "/TemporaryDirectory\\.[^/]+/[^/]+-manifest$")))

;; Read — Xcode bundle (CLT covered by base /Library allow).
(allow file-read-data
  (subpath "/Applications/Xcode.app"))

;; Read+write — SwiftPM caches, config/trust store, and ~/.swiftpm
;; (swift-package recreates the symlinks under ~/.swiftpm).
(allow file-read-data
  (subpath (string-append (param "HOME") "/Library/Caches/org.swift.swiftpm"))
  (subpath (string-append (param "HOME") "/Library/org.swift.swiftpm"))
  (subpath (string-append (param "HOME") "/.swiftpm")))
(allow file-write*
  (subpath (string-append (param "HOME") "/Library/Caches/org.swift.swiftpm"))
  (subpath (string-append (param "HOME") "/Library/org.swift.swiftpm"))
  (subpath (string-append (param "HOME") "/.swiftpm")))

;; Read — CoreFoundation reads this on startup of CF-linked binaries.
(allow file-read-data
  (path (string-append (param "HOME") "/.CFUserTextEncoding")))

;; lldb — pty allocation for the inferior, and the Python scripting
;; bridge's .pyc cache under ~/Library/Caches/com.apple.python.
(allow pseudo-tty)
(allow file-read-data
  (subpath (string-append (param "HOME") "/Library/Caches/com.apple.python")))
