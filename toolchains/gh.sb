;; GitHub CLI toolchain
;;
;; gh binary is at /opt/homebrew/bin/gh (base profile covers exec).
;; This toolchain only grants read access to auth config.
;; Read-only: the sandbox should not allow modifying auth tokens.
;;
;; gh stores its token in one of two places depending on how the host
;; was set up:
;;   - Plaintext: ~/.config/gh/hosts.yml (oauth_token: field)
;;   - Keyring:   the macOS login keychain (gh's default on macOS when
;;                secure storage is available; hosts.yml then only records
;;                the user, with no oauth_token: field)
;; Both must be readable or `gh auth status` reports the token invalid.
;; base-claude.sb (Claude) already grants keychain read for Claude Code's own
;; OAuth credentials, but base-codex.sb / base-pi.sb do not — Codex and Pi
;; keep their own auth in plain files. So the keychain grant lives here,
;; scoped to projects that opt into `tool gh`, to make gh work uniformly
;; across all launchers.

;; Read — plaintext auth tokens and host configuration
(allow file-read-data
  (subpath (string-append (param "HOME") "/.config/gh")))

;; Read — keyring token storage (macOS login keychain database).
;; Item-level ACLs are still enforced by securityd; the sandbox can only
;; grant/deny at the keychain-file level, matching base-claude.sb's own grant.
(allow file-read-data
  (subpath (string-append (param "HOME") "/Library/Keychains")))
